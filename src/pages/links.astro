    title="トラマト"
    description="このホームページ作成のきっかけになった人です"
  />

  <LongLinks
    href="https://lanips-homepage.vercel.app/"
    image="/images/ラニプスさん.jpg"
    alt="ラニプスさん"
    title="Lanios"
    description="曲も作ってるしホムペもかっこいいすごい人です"
  />

  <LongLinks
    href="https://intro-shiwata.vercel.app/"
    image="/images/しわた.jpg"
    alt="しわたさん"
    title="しわた"
    description="いつ休んでいるかわからない人です"
  />

  <LongLinks
    href="https://amigo-homepage.vercel.app/"
    image="/images/あみーご.jpg"
