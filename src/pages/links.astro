  />


  <!-- リンク2 -->
  <LongLinks
    href="https://x.com/Mizukimo_Oekaki"
    image="/images/アイコン.png"
    alt="X"
    title="X"
    description="イラストのほかにも割とどうでもいい情報も投稿します"
  />

</Layout>


<style>

.profile-img {
  width: 100px;
  height: 100px;
  border-radius: 50%;
