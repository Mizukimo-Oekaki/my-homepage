---
import Layout from '../layouts/layouts.astro';
import Kaisetu from '../layouts/kaisetu.astro';
import Kaisetu2 from '../layouts/kaisetu2.astro';
---

<Layout title="水胆の作品">

  <h1>作品紹介</h1>

  <p>水胆の作品の紹介・解説を行います</p>

<div class="modal-icons">

<Kaisetu>

  <!-- 丸いアイコンにする画像 -->

    <img
      slot="icon"
      src="/images/ハエたたき.jpg"
      alt="作品10"
    >


    <!-- 左側に表示する画像 -->

    <img
      slot="image"
      src="/images/ハエたたき.jpg"
      alt="作品10"
    >


    <!-- 右側に表示する文章 -->

    <div slot="text">

      <h2>水端さん</h2>
      <small>2026年9月頃制作</small>

      <p>
        「あークソッ！酒が切れやがった死ね！！」
      </p>

      <p>
      水胆の代理の水端さんです<br>
      自身を17歳の女子高生と勘違いしている成人女性で、嫌味を言うハエの幻覚に悩まされています。
      </p>

    </div>


</Kaisetu>

<Kaisetu>

  <!-- 丸いアイコンにする画像 -->

    <img
      slot="icon"
      src="/images/水死体.jpg"
      alt="作品9"
    >


    <!-- 左側に表示する画像 -->

    <img
      slot="image"
      src="/images/水死体.jpg"
      alt="作品9"
    >


    <!-- 右側に表示する文章 -->

    <div slot="text">

      <h2>波の子</h2>
      <small>2026年8月頃制作</small>

      <p>
        通称なみこ
      </p>

      <p>
       時代の波に溺れた哀れな女の子です<br>
       左右に飛んでるクリオネみたいなやつは彼女の記憶の化身で、さっと茹でて氷水で絞めて酢醤油で食べると彼女の記憶がじゅわっと舌と脳を刺激します。
      </p>

    </div>


</Kaisetu>

<Kaisetu>

  <!-- 丸いアイコンにする画像 -->

    <img
      slot="icon"
      src="/images/シューム.jpg"
      alt="作品8"
    >


    <!-- 左側に表示する画像 -->

    <img
      slot="image"
      src="/images/シューム.jpg"
      alt="作品8"
    >


    <!-- 右側に表示する文章 -->

    <div slot="text">

      <h2>シューム</h2>
      <small>2026年8月頃制作</small>

      <p>
        お役御免
      </p>

      <p>
      水胆が小学生のころに作成したキャラクターの4回目のリメイクです。<br>
      何回も作り直しているうちに愛着がわいてきて思わず描いてしまいました。
      </p>

    </div>


</Kaisetu>


<Kaisetu>

  <!-- 丸いアイコンにする画像 -->

    <img
      slot="icon"
      src="/images/ぎっくり腰.jpg"
      alt="作品7"
    >


    <!-- 左側に表示する画像 -->

    <img
      slot="image"
      src="/images/ぎっくり腰.jpg"
      alt="作品7"
    >


    <!-- 右側に表示する文章 -->

    <div slot="text">

      <h2>ぎっくり腰</h2>
      <small>2026年7月頃制作</small>

      <p>
        もう絶対なりたくないやめてマジで死にかけたから
      </p>

      <p>
      ソフトボールのゴロを拾おうとかがんだらぎっくり腰になりました。知り合いに笑われるわ数日腰曲げられなくて屈伸煽りみたいな動きしか取れないわ週末捻挫になるわで散々ですもう一生なりたくない。<br>
      この辛さを伝えるべく腰からコンニャクの花を咲かせて嫌なにおいを出させました。運動はちゃんとやりましょうぎっくり腰は魔女の一撃です。

      </p>

    </div>
    
    </Kaisetu>



  <Kaisetu>

  <!-- 丸いアイコンにする画像 -->

    <img
      slot="icon"
      src="/images/んぴゅ.jpg"
      alt="作品1"
    >


    <!-- 左側に表示する画像 -->

    <img
      slot="image"
      src="/images/んぴゅ.jpg"
      alt="作品1"
    >


    <!-- 右側に表示する文章 -->

    <div slot="text">

      <h2>ようこそ混乱の世界</h2>
      <small>2026年5月頃制作</small>

      <p>
        通称んぴゅ子
      </p>

      <p>
        いつまで経っても慣れないコンピュータの操作に疲れた水胆の図。
        Edgeは荒波に、Fire Foxは女の子を襲う狐の化け物に、Windousは月にして浮世絵風に仕立てました。
      </p>

    </div>


</Kaisetu>

<Kaisetu>

  <!-- 丸いアイコンにする画像 -->

    <img
      slot="icon"
      src="/images/石油.jpg"
      alt="作品2"
    >


    <!-- 左側に表示する画像 -->

    <img
      slot="image"
      src="/images/石油.jpg"
      alt="作品3"
    >


    <!-- 右側に表示する文章 -->

    <div slot="text">

      <h2>贈る</h2>
      <small>2026年6月頃制作</small>

      <p>
        石油で作った百合の花
      </p>

      <p>
        大好きな人と油田地域で心中すれば、10億年石油として一緒にいられるのではないかと考えて作成しました。<br>
        有識者に聞いたところ、人間は石油になれないそうなので、この恋愛は実現できません、残念。
      </p>

    </div>
</Kaisetu>

<Kaisetu>

  <!-- 丸いアイコンにする画像 -->

    <img
      slot="icon"
      src="/images/あせも.jpg"
      alt="作品2"
    >


    <!-- 左側に表示する画像 -->

    <img
      slot="image"
      src="/images/あせも.jpg"
      alt="作品3"
    >


    <!-- 右側に表示する文章 -->

    <div slot="text">

      <h2>大嫌い</h2>
      <small>2026年2月頃制作</small>

      <p>
        通称あせもちゃん
      </p>

      <p>
        引っ搔いたあせもが流星群みたいできれいだったので作成しました。あせもは掻かずに薬を塗りましょう。引っ掻き痕が窪んだりシミになったりしてしまいます。
      </p>

    </div>
</Kaisetu>

<Kaisetu>

  <!-- 丸いアイコンにする画像 -->

    <img
      slot="icon"
      src="/images/メンヘラ.jpg"
      alt="作品2"
    >


    <!-- 左側に表示する画像 -->

    <img
      slot="image"
      src="/images/メンヘラ.jpg"
      alt="作品4"
    >


    <!-- 右側に表示する文章 -->

    <div slot="text">

      <h2>メンヘラ</h2>
      <small>2026年7月頃制作</small>

      <p>
        こうであってたまるか
      </p>

      <p>
      誰からも見られてほしいのに、自分のことは見ていない。やることなすことすべてが絡みついて自分の妨げとなってしまう。そんな水胆の持つメンヘラのイメージを作成しました。<br>
      2次元ならまだしも3次元のメンヘラは本当に迷惑ということを、メンヘラを自覚している人は肝に銘じてください。
      </p>

    </div>
</Kaisetu>

<Kaisetu>

  <!-- 丸いアイコンにする画像 -->

    <img
      slot="icon"
      src="/images/先輩.jpg"
      alt="作品2"
    >


    <!-- 左側に表示する画像 -->

    <img
      slot="image"
      src="/images/先輩.jpg"
      alt="作品5"
    >


    <!-- 右側に表示する文章 -->

    <div slot="text">

      <h2>先輩4色チャレンジ</h2>
      <small>2026年8月頃制作</small>

      <p>
        できる限り汚さを排除しました
      </p>

      <p>
      とあるミームの4色のみを使った4色チャレンジです。ブレイキンの人が大きめの服を着るのは多分映えるからだと思います。
      </p>

    </div>
</Kaisetu>

<Kaisetu2 label="二次創作">

  <!-- 丸いアイコンにする画像 -->

    <img
      slot="icon"
      src="/images/パスタ.png"
      alt="作品6"
    >


    <!-- 左側に表示する画像 -->

    <img
      slot="image"
      src="/images/パスタ.png"
      alt="作品6"
    >


    <!-- 右側に表示する文章 -->

    <div slot="text">

      <h2>ミミズパスタ定食</h2>
      <small>2026年3月頃制作</small>

      <p>
        原曲：ミミズパスタ定食 / 鯖頭 様
      </p>

      <p>
      ミクの日2026に向けて制作した作品です。<br>
      このイラストの原曲となった鯖頭様の「ミミズパスタ定食」は(いい意味で)恐ろしい作品で、このパスタの主は何をしたかったのか、最終的にどうなったのかが全く理解できませんでした。<br>
      それなのに、疾走感のあるメロディーとサビの歌詞が頭から離れません。いつの間にか口ずさんでいる楽しい曲です。
      </p>

    </div>
</Kaisetu2>


</div>


</Layout>

<style>
.modal-icons {
  display: flex;
  flex-wrap: wrap;
  gap: 2rem;
  justify-content: center;
  align-items: flex-start;
  margin-top: 2rem;
}
</style>
