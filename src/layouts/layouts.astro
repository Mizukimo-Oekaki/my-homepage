---
const { title } = Astro.props;
---

<html lang="ja">

<head>

  <!-- ファビコン -->
  <link rel="icon" href="/images/水胆.png">

  <!-- 基本設定 -->
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />

  <title>{title}</title>

  <meta
    name="description"
    content="水胆の作品紹介・解説を行っているホームページです。"
  />

  <!-- =========================
       OGP
       ========================= -->

  <meta
    property="og:title"
    content={title}
  />

  <meta
    property="og:description"
    content="水胆の作品紹介・解説を行っているホームページです。"
  />

  <meta
    property="og:image"
    content="https://my-homepage-rosy-rho.vercel.app/images/水胆.png"
  />

  <meta
    property="og:url"
    content="https://my-homepage-rosy-rho.vercel.app/"
  />

  <meta
    property="og:type"
    content="website"
  />

  <meta
    property="og:site_name"
    content="水胆のホームページ"
  />

  <meta
    property="og:image:alt"
    content="水胆のホームページ"
  />

  <meta
    property="og:image:type"
    content="image/png"
  />

  <!-- =========================
       X
       ========================= -->

  <meta
    name="twitter:card"
    content="summary_large_image"
  />

  <meta
    name="twitter:title"
    content={title}
  />

  <meta
    name="twitter:description"
    content="水胆の作品紹介・解説を行っているホームページです。"
  />

  <meta
    name="twitter:image"
    content="https://my-homepage-rosy-rho.vercel.app/images/水胆.png"
  />

  <!-- =========================
       Google Fonts
       ========================= -->

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Kiwi+Maru&display=swap"
    rel="stylesheet"
  >
   <img src="/images/水胆.png" alt="ヘッダー" class="img1">
</head>

<body>

  <header>
    <nav>
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/works">Works</a>
      <a href="/links">Links</a>
    </nav>
  </header>


  <main>
    <slot />
  </main>


  <!-- 丸型リンクアイコン -->
  <div class="link-icons">

    <!-- pixiv -->
    <a
      href="https://www.pixiv.net/users/78629423"
      class="link-icon"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="pixiv"
    >
      <img src="/images/pixiv.jpg" alt="p">
    </a>

    <!-- X -->
    <a
      href="https://x.com/Mizukimo_Oekaki"
      class="link-icon"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="X"
    >
      <img src="/images/logo-black.png" alt="X">
    </a>

  </div>


  <footer>
    © 2026　水胆
  </footer>

</body>
</html>


<style>

body {
  max-width: 720px;
  margin: 0 auto;
  padding: 2rem 1.5rem;
  font-family: "Kiwi Maru", serif;
  line-height: 1.8;
  color: #333;
  background-color: #f4f6f8;
}


/* ナビゲーション */
nav {
  display: flex;
  gap: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid #ddd;
}

nav a {
  color: #5bc8ac;
  text-decoration: none;
  transition: color 0.2s ease-in-out;
}

nav a:hover {
  color: #f18d9e;
}


/* 白いプレート */
main {
  background-color: #fff;
  border-radius: 12px;
  box-shadow: 0 2px 16px rgba(0, 0, 0, 0.08);
  padding: 2rem;
  margin-top: 1.5rem;
}


/* 丸型リンクアイコン */
.link-icons {
  display: flex;
  justify-content: center;
  align-items: center;

  gap: 1.2rem;

  margin-top: 2rem;
  margin-bottom: 1rem;
}


/* 丸いアイコン */
.link-icon {
  width: 60px;
  height: 60px;

  border-radius: 50%;

  display: flex;
  justify-content: center;
  align-items: center;

  background-color: #fff;

  color: #5bc8ac;
  text-decoration: none;

  font-size: 1.4rem;
  font-weight: bold;

  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.10);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    color 0.2s ease;
}

.link-icon img {
  width: 24px;
  height: 24px;
}

/* マウスを乗せたとき */
.link-icon:hover {
  transform: translateY(-5px);

  color: #f18d9e;

  box-shadow: 0 5px 18px rgba(0, 0, 0, 0.15);
}


/* フッター */
footer {
  margin-top: 2rem;
  padding-top: 1rem;
  font-size: 0.85rem;
  color: #888;
}

.img1 {
  width: 70px;
  height: auto;
  display: block;
  margin-left: auto;
  margin-right: 0;

}


/* =========================
   スマートフォン用
   ========================= */

@media (max-width: 600px) {

  /* =========================
     ページ全体
     ========================= */

  body {
    padding: 1rem;
  }


  /* =========================
     ナビゲーション
     ========================= */

  nav {
    gap: 0.8rem;

    flex-wrap: wrap;

    padding-bottom: 0.8rem;
  }


  nav a {
    font-size: 0.9rem;
  }


  /* =========================
     メインの白いプレート
     ========================= */

  main {
    padding: 1.2rem;

    margin-top: 1rem;

    border-radius: 10px;
  }


  /* =========================
     見出し
     ========================= */

  h1 {
    font-size: 1.7rem;

    line-height: 1.5;
  }


  h2 {
    font-size: 1.3rem;

    line-height: 1.5;
  }


  /* =========================
     画像
     ========================= */

  main img {
    max-width: 100%;

    height: auto;
  }


  /* =========================
     SNSアイコン
     ========================= */

  .link-icons {
    gap: 0.8rem;

    margin-top: 1.5rem;
    margin-bottom: 1rem;

    flex-wrap: wrap;
  }


  .link-icon {
    width: 55px;
    height: 55px;

    flex-shrink: 0;
  }


  .link-icon img {
    width: 22px;
    height: 22px;
  }


  /* =========================
     ヘッダー画像
     ========================= */

  .img1 {
    width: 55px;

    max-width: 100%;

    height: auto;
  }


  /* =========================
     フッター
     ========================= */

  footer {
    margin-top: 1.5rem;

    padding-top: 0.8rem;

    font-size: 0.75rem;
  }

}


/* =========================
   小さいスマートフォン用
   ========================= */

@media (max-width: 400px) {

  body {
    padding: 0.7rem;
  }


  /* ナビゲーション */

  nav {
    gap: 0.6rem;
  }


  nav a {
    font-size: 0.8rem;
  }


  /* メイン */

  main {
    padding: 1rem;
  }


  /* 見出し */

  h1 {
    font-size: 1.5rem;
  }


  h2 {
    font-size: 1.2rem;
  }


  /* SNSアイコン */

  .link-icons {
    gap: 0.7rem;
  }


  .link-icon {
    width: 50px;
    height: 50px;
  }


  .link-icon img {
    width: 20px;
    height: 20px;
  }


  /* ヘッダー画像 */

  .img1 {
    width: 50px;
  }

}

</style>