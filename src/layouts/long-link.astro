

---
const {
  href = "#",
  image = "",
  alt = "",
  title = "",
  description = ""
} = Astro.props;
---

<div class="link-box">

  <!-- 左側：丸いアイコン -->
  <div class="link-image">
    {image && <img src={image} alt={alt} />}
  </div>


  <!-- 中央：タイトルと説明 -->
  <div class="link-text">

    <h2>{title}</h2>

    <p>{description}</p>

  </div>


  <!-- 右側：リンク -->
  <a href={href} class="link-arrow">
    &gt;
  </a>

</div>


<style>

/* =========================
   横長のリンクボックス
   ========================= */

.link-box {
  width: 600px;
  height: 120px;

  display: flex;
  align-items: center;

  background-color: #fff;

  border: 1px solid #ddd;
  border-radius: 12px;

  box-sizing: border-box;

  margin: 1.5rem auto;

  overflow: hidden;
}


/* =========================
   左：丸いアイコン
   ========================= */

.link-image {
  width: 90px;
  height: 90px;

  margin-left: 15px;

  border-radius: 50%;

  overflow: hidden;

  flex-shrink: 0;

  background-color: #fff;
}


.link-image img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  display: block;
}


/* =========================
   中央：タイトル・説明
   ========================= */

.link-text {
  flex: 1;

  padding: 0 1.5rem;

  text-align: left;
}


.link-text h2 {
  margin: 0 0 0.4rem 0;

  font-size: 1.2rem;

  font-weight: bold;
}


.link-text p {
  margin: 0;

  font-size: 0.9rem;

  line-height: 1.6;

  color: #666;
}


/* =========================
   右：> リンクボタン
   ========================= */

.link-arrow {
  width: 80px;
  height: 100%;

  display: flex;

  justify-content: center;
  align-items: center;

  text-decoration: none;

  color: #555;

  font-size: 42px;

  flex-shrink: 0;
}


.link-arrow:hover {
  color: #f18d9e;
}


/* =========================
   スマートフォン
   ========================= */

@media (max-width: 600px) {

  .link-box {
    width: 90%;
    height: 100px;
  }

  .link-image {
    width: 70px;
    height: 70px;

    margin-left: 10px;
  }

  .link-text {
    padding: 0 1rem;
  }

  .link-text h2 {
    font-size: 1rem;
  }

  .link-text p {
    font-size: 0.8rem;
  }

  .link-arrow {
    width: 55px;
    font-size: 32px;
  }

}

</style>